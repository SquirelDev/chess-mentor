{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "shell:execute",
      "description": "Permission to execute the Stockfish sidecar",
      "windows": ["main"],
      "allow": [
        {
          "name": "stockfish-sidecar",
          "cmd": "$RESOURCE/engine/stockfish",
          "sidecar": true
        }
      ]
    }
  ]
}
